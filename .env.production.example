# .env.production.example
# Copy this file to .env before running docker-compose.prod.yml
# cp .env.production.example .env

# Domains
DOMAIN_APP=portal.thesource-company.in
DOMAIN_API=api.thesource-company.in
DOMAIN_WWW=www.thesource-company.in

# Traefik / SSL
ACME_EMAIL=admin@thesource-company.in

# Database Secrets
POSTGRES_USER=thesource_prod
POSTGRES_PASSWORD=generate_a_secure_password_here
POSTGRES_DB=thesource_prod

# Redis Secrets
REDIS_PASSWORD=generate_a_secure_redis_password_here

# Backend Secrets
# Generate via: openssl rand -hex 32
JWT_SECRET_KEY=generate_a_secure_jwt_secret_here

# Twilio SMS OTP Credentials
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=

