# ──────────────────────────────────────────────────────────────
# The Source Company — Environment Configuration
# Copy to .env and fill in real values for your environment.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# ── App ──
APP_NAME=TheSourceCompany
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# ── API ──
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:3001","http://127.0.0.1:8000"]

# ── Database ──
DATABASE_URL=postgresql+asyncpg://thesource:thesource_dev@localhost:5432/thesource_dev
DATABASE_URL_SYNC=postgresql+psycopg2://thesource:thesource_dev@localhost:5432/thesource_dev

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── MQTT ──
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# ── Auth / JWT ──
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Google OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── External Services (all default to disabled/stubbed) ──
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
TWILIO_PHONE_NUMBER=

SES_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
SES_FROM_EMAIL=noreply@thesource-company.com

S3_ENABLED=false
S3_BUCKET_NAME=thesource-uploads
S3_ENDPOINT_URL=

WEATHER_API_ENABLED=false
WEATHER_API_KEY=
WEATHER_API_PROVIDER=openweathermap

GOOGLE_MAPS_API_KEY=

# ── File Storage ──
UPLOAD_DIR=./uploads
